{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.5.0",
  "homepage_url": "https://github.com/kaleidooa/glimpse-dictionary",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "lab/dashboard.html#settings",
  "commands": {
    "lookup-word": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_lookupCommand__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' https://api.dictionaryapi.dev;"
  },
  "default_locale": "en"
}
