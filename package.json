{
  "name": "eye-track-dictionary",
  "version": "0.7.0",
  "private": true,
  "description": "Local-first English-to-Korean cursor dictionary for Chrome, with an explicit local wordbook.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaleidooa/glimpse-dictionary.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --maxWorkers=4",
    "assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs",
    "build:extension": "tsc -b && node scripts/build-extension.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "check:public": "node scripts/check-public-source.mjs",
    "benchmark:dictionary": "node scripts/benchmark-dictionary.mjs",
    "package:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "format": "prettier --write src extension server scripts vite.config.ts dashboard.html index.html"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
